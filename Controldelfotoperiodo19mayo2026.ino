void setup() {
    Serial.begin(115200);

    WiFi.mode(WIFI_STA);
    WiFi.disconnect(false, false);
    delay(100);
    printStaMac();

    if (esp_now_init() != ESP_OK) { Serial.println("ESP-NOW ERROR"); return; }
    esp_now_register_send_cb(OnDataSent);
    esp_now_register_recv_cb(OnDataRecv);

    auto addPeer = [](uint8_t* mac) {
        esp_now_peer_info_t p = {};
        memcpy(p.peer_addr, mac, 6);
        p.channel = 0; p.encrypt = false;
        if (esp_now_add_peer(&p) != ESP_OK) Serial.println("PEER ERROR");
    };
    addPeer(macInvernadero);
    addPeer(macSoilNode);
    addPeer(macCalendarioESP);

    delay(500);
    SPI.begin(12, 13, 11);
    tft.init(240, 320);
    tft.setRotation(1);
    tft.invertDisplay(false);
    tft.fillScreen(MI_NEGRO);

    ts.begin();
    ts.setRotation(1);

    if (SD.begin(SD_CS)) { loadState(); loadHistory(); }

    pinMode(RELAY_PIN, OUTPUT);
    configTime(-21600, 0, "pool.ntp.org"); // UTC-6

    lastMillis     = millis();
    lastTouchTime  = millis();
    lastAutoSave   = millis();
    weedNeedsRedraw = true;

    // Pantalla de bienvenida
    drawSplash();
}

// ─────────────────────────────────────────────
//  SPLASH –  carga logo desde SD (rápido, sin watchdog)
//  Guarda el archivo 'logo.raw' en la raíz de la SD
// ─────────────────────────────────────────────
void drawSplash() {
    tft.fillScreen(MI_NEGRO);

    const int LOGO_W = 220;
    const int LOGO_H = 220;
    int x0 = (tft.width()  - LOGO_W) / 2;   // 50
    int y0 = (tft.height() - LOGO_H) / 2;   // 10

    if (!SD.exists("/logo.raw")) {
        // Fallback si no hay logo en SD
        tft.setTextSize(2);
        tft.setTextColor(MI_VERDE_NEON, MI_NEGRO);
        tft.setCursor(60, 100);
        tft.print("GROW CTRL v2");
        delay(800);
        tft.fillScreen(MI_NEGRO);
        return;
    }

    File f = SD.open("/logo.raw");
    if (!f || f.size() < LOGO_W * LOGO_H * 2) {
        tft.setTextSize(1);
        tft.setTextColor(ST77XX_RED, MI_NEGRO);
        tft.setCursor(20, 110);
        tft.print("Error logo.raw");
        delay(1000);
        tft.fillScreen(MI_NEGRO);
        return;
    }

    // Dibujado ultra-rápido: leer chunks de SD y pushColor
    tft.startWrite();
    tft.setAddrWindow(x0, y0, LOGO_W, LOGO_H);
    uint8_t buf[512];           // buffer de 512 bytes = 256 pixels
    while (f.available()) {
        int n = f.read(buf, sizeof(buf));
        for (int i = 0; i < n; i += 2) {
            uint16_t c = (buf[i] << 8) | buf[i + 1];
            tft.pushColor(c);
        }
    }
    tft.endWrite();
    f.close();

    // Esperar 2s o tocar para saltar
    unsigned long t0 = millis();
    while (millis() - t0 < 2000) {
        if (ts.touched()) {
            while (ts.touched()) { yield(); delay(10); }
            break;
        }
        yield();
        delay(50);
    }

    tft.fillScreen(MI_NEGRO);
}

// ─────────────────────────────────────────────
//  SPLASH (opcional – breve animación de inicio)
// ─────────────────────────────────────────────

void updatePhotoperiod() {
    unsigned long now  = millis();
    double delta       = (now - lastMillis) / 1000.0;
    lastMillis         = now;
    double totalSecs   = (lightHours + darkHours) * 3600.0;
    double lightSecs   = lightHours * 3600.0;

    // ── INTENTO DE ANCLAR A RTC ──────────────────
    if (!rtcAnchored) {
        time_t epoch = time(nullptr);
        if (epoch > 1700000000L) {          // NTP válido (año > 2023)
            // Usamos el valor guardado en SD si existe y es razonable
            if (cycleStartEpoch > 0 &&
                difftime(epoch, cycleStartEpoch) >= 0 &&
                difftime(epoch, cycleStartEpoch) < totalSecs * 30) {
                // Ancla restaurada desde SD – no modificar cycleStartEpoch
            } else {
                // Primera vez: calculamos el inicio del ciclo actual
                // restando los segundos ya transcurridos
                cycleStartEpoch = epoch - (time_t)photoSecondsElapsed;
            }
            rtcAnchored = true;
            Serial.printf("[RTC] Anclado. cycleStart=%ld\n", (long)cycleStartEpoch);
        }
    }

    // ── POSICIÓN EN EL CICLO ─────────────────────
    if (rtcAnchored) {
        time_t epoch = time(nullptr);
        double elapsed = difftime(epoch, cycleStartEpoch);
        // Manejo de rollover de días
        while (elapsed >= totalSecs) {
            elapsed -= totalSecs;
            cycleStartEpoch += (time_t)totalSecs;
            if (isVegetative) daysVeg++; else daysFlower++;
            saveState();
        }
        if (elapsed < 0) elapsed = 0;
        photoSecondsElapsed = elapsed;
    } else {
        // Respaldo millis()
        photoSecondsElapsed += delta;
        if (photoSecondsElapsed >= totalSecs) {
            photoSecondsElapsed = 0;
            if (isVegetative) daysVeg++; else daysFlower++;
            saveState();
        }
    }

    // ── RELAY ─────────────────────────────────────
    bool newLight = (photoSecondsElapsed < lightSecs);
    if (newLight != inLightMode) {
        inLightMode = newLight;
        uiNeedsFullRedraw = true;
    }
    digitalWrite(RELAY_PIN, inLightMode ? LOW : HIGH);

    // ── HISTORIAL ─────────────────────────────────
    if (now - lastHistoryUpdate > 3600000UL) {
        for (int i = 0; i < 23; i++) history[i] = history[i+1];
        history[23] = (photoSecondsElapsed / totalSecs) * 100.0;
        lastHistoryUpdate = now;
    }
}

