bool inLightMode  = true;
bool showGraph    = false;

// ── ANCLAJE A RTC ────────────────────────────
// En lugar de acumular segundos con millis(), guardamos la
// epoch Unix del inicio del ciclo actual y calculamos la posición
// a partir de time() para evitar drift tras días de operación.
time_t cycleStartEpoch  = 0;    // epoch del inicio del ciclo actual
bool   rtcAnchored       = false; // true cuando tenemos hora NTP válida
// Respaldo en millis() mientras RTC no está listo
double photoSecondsElapsed = 0;

float history[24];

// ─────────────────────────────────────────────
//  ESP-NOW  ESTRUCTURAS
// ─────────────────────────────────────────────
typedef struct {
    int   lightHours, darkHours, daysVeg, daysFlower;
    bool  isVegetative, inLightMode;
    float progressPercent;
    int   hour, minute, second;
    float vpd;
} struct_message;

struct_message growData;

typedef struct {
    float vpd, tds, ph, soil1, soil2, co2, airTemp, airHum;
    bool  relayState;
} greenhouse_message;

greenhouse_message greenhouseData;

typedef struct {
    float soil1, soil2, co2;
} soil_message;

