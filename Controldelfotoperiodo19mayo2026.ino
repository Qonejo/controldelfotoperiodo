    static int pDV = -1;
    if (uiNeedsFullRedraw || daysVeg != pDV) {
        tft.fillRect(0, 110, 240, 26, MI_NEGRO);
        tft.setTextSize(2);
        tft.setTextColor(MI_BLANCO, MI_NEGRO);
        tft.setCursor(8, 114);
        tft.print("DIAS VEG:");
        tft.setTextColor(MI_VERDE_NEON, MI_NEGRO);
        char buf[8];
        snprintf(buf, 8, "%d", daysVeg);
        tft.setCursor(130, 114);
        tft.print(buf);
        tft.setTextColor(ST77XX_RED, MI_NEGRO);
        tft.setCursor(175, 114);
        tft.print("<");
        tft.setCursor(195, 114);
        tft.print(">");
        pDV = daysVeg;
    }

    // ── DIAS FLOR : #  < >  (texto GRANDE) ──
    static int pDF = -1;
    if (uiNeedsFullRedraw || daysFlower != pDF) {
        tft.fillRect(0, 140, 240, 26, MI_NEGRO);
        tft.setTextSize(2);
        tft.setTextColor(MI_BLANCO, MI_NEGRO);
        tft.setCursor(8, 144);
        tft.print("DIAS FLOR:");
        tft.setTextColor(MI_AMBER, MI_NEGRO);
        char buf[8];
        snprintf(buf, 8, "%d", daysFlower);
        tft.setCursor(140, 144);
        tft.print(buf);
        tft.setTextColor(ST77XX_RED, MI_NEGRO);
        tft.setCursor(185, 144);
        tft.print("<");
        tft.setCursor(205, 144);
        tft.print(">");
        pDF = daysFlower;
    }

    // ── BARRA DE PROGRESO ─────────────────────
    {
        double phaseDur = inLightMode ? (lightHours * 3600.0) : (darkHours * 3600.0);
        double phaseElap = inLightMode ? photoSecondsElapsed : (photoSecondsElapsed - lightHours * 3600.0);
        if (phaseDur <= 0) phaseDur = 1;
        phaseElap = constrain(phaseElap, 0.0, phaseDur);
        float perc = (float)(phaseElap / phaseDur) * 100.0f;
        perc = constrain(perc, 0.0f, 100.0f);

        const int bx = 10, by = 174, bw = 220, bh = 14;
        static int lastFill = -1;

        if (uiNeedsFullRedraw) {
            tft.drawRect(bx, by, bw, bh, MI_BLANCO);
            lastFill = -1;
        }
        int fill = constrain((int)((bw - 4) * (perc / 100.0f)), 0, bw - 4);
        uint16_t barCol = isVegetative ? MI_VERDE_NEON : MI_AMBER;
        if (fill != lastFill) {
            if (fill > 0) tft.fillRect(bx + 2, by + 2, fill, bh - 4, barCol);
            int rest = (bw - 4) - fill;
            if (rest > 0) tft.fillRect(bx + 2 + fill, by + 2, rest, bh - 4, MI_NEGRO);
            lastFill = fill;
        }
    }

    // ── FASE : LUZ < >  +  tiempo  +  %  (texto chico) ──
    static int pLM = -1;
    if (uiNeedsFullRedraw || (int)inLightMode != pLM) {
        tft.fillRect(0, 196, 130, 20, MI_NEGRO);
        tft.setTextSize(1);
        tft.setTextColor(MI_BLANCO, MI_NEGRO);
        tft.setCursor(8, 200);
        tft.print("FASE:");
        uint16_t faseCol = isVegetative ? MI_VERDE_NEON : MI_AMBER;
        tft.setTextColor(faseCol, MI_NEGRO);
        tft.setCursor(50, 200);
        tft.print(inLightMode ? "LUZ" : "OSC");
        tft.setTextColor(ST77XX_RED, MI_NEGRO);
        tft.setCursor(80, 200);
        tft.print("<");
        tft.setCursor(95, 200);
        tft.print(">");
        pLM = (int)inLightMode;
    }

    // Tiempo restante de fase
    double phaseDur = inLightMode ? (lightHours * 3600.0) : (darkHours * 3600.0);
    double phaseElap = inLightMode ? photoSecondsElapsed : (photoSecondsElapsed - lightHours * 3600.0);
    double remaining = phaseDur - phaseElap;
    if (remaining < 0) remaining = 0;
    int rh = (int)(remaining / 3600);
    int rm = (int)((long)remaining % 3600 / 60);
    int rs = (int)((long)remaining % 60);

    tft.setTextSize(1);
    tft.setTextColor(MI_BLANCO, MI_NEGRO);
    char timeBuf[12];
    snprintf(timeBuf, 12, "%02d:%02d:%02d", rh, rm, rs);
    tft.setCursor(140, 200);
    tft.print(timeBuf);

    float perc = (float)(phaseElap / phaseDur) * 100.0f;
    if (phaseDur <= 0) perc = 0;
    perc = constrain(perc, 0.0f, 100.0f);
    char pctBuf[8];
    snprintf(pctBuf, 8, "%d%%", (int)perc);
    tft.setTextColor(MI_AMBER, MI_NEGRO);
    tft.setCursor(210, 200);
    tft.print(pctBuf);

    // ── PANEL DERECHO: VPD / TDS / CO2 / Suelo ──
    drawVPD();
    drawTDS();
    drawCO2();
    drawSoilBars();

    uiNeedsFullRedraw = false;
}

// ─────────────────────────────────────────────
//  GRÁFICO 24H
// ─────────────────────────────────────────────
void drawGraph() {
    tft.fillScreen(MI_NEGRO);
    // Título
    tft.fillRect(0,0,320,16,0x0820);
    tft.setTextSize(1); tft.setTextColor(MI_VERDE_NEON,0x0820);
    tft.setCursor(70,4); tft.print("[ HISTORIAL FOTOPERIODO 24H ]");

    // Ejes
    tft.drawLine(28,20,28,210,0x4208);
    tft.drawLine(28,210,310,210,0x4208);

    // Etiquetas Y
    for (int v=0;v<=100;v+=25) {
        int yp=210-(int)(v*1.5f);
        tft.drawLine(26,yp,29,yp,0x4208);
        tft.setTextSize(1); tft.setTextColor(0x4208,MI_NEGRO);
        tft.setCursor(8,yp-3); tft.printf("%3d",v);
    }

    // Curva con área rellena
    for (int i=0;i<23;i++) {
        float v1=constrain(history[i],0,100);
        float v2=constrain(history[i+1],0,100);
        int x1=30+(i*12), y1=210-(int)(v1*1.5f);
        int x2=30+((i+1)*12), y2=210-(int)(v2*1.5f);
        // Sombra verde tenue
        tft.drawLine(x1,y1+1,x2,y2+1,0x0320);
        tft.drawLine(x1,y1,x2,y2,MI_VERDE_NEON);
    }

    tft.setTextSize(1); tft.setTextColor(0x4208,MI_NEGRO);
    tft.setCursor(85,220); tft.print("<<< TOCAR PARA VOLVER >>>");
}

// ─────────────────────────────────────────────
//  HANDLE ACTION  –  solo cambia variables, NO bloquea
//  El loop principal se encarga de saveState() y drawUI()
// ─────────────────────────────────────────────
void handleAction(int tx, int ty, int step) {
    if (showGraph) {
        showGraph = false;
        uiNeedsFullRedraw = true;
        weedNeedsRedraw = true;
        return;
    }

    // Barra de progreso (y = 174..188)
    if (ty >= 174 && ty <= 188) {
        float ratio = constrain((float)(tx - 10) / 220.0f, 0.0f, 1.0f);
        double phDur = inLightMode ? (lightHours * 3600.0) : (darkHours * 3600.0);
        photoSecondsElapsed = inLightMode ? (ratio * phDur) : (lightHours * 3600.0 + (ratio * phDur));
        if (photoSecondsElapsed < 0) photoSecondsElapsed = 0;
        double totalSecs = (lightHours + darkHours) * 3600.0;
        if (photoSecondsElapsed >= totalSecs) photoSecondsElapsed = totalSecs - 1;
        if (rtcAnchored) {
            cycleStartEpoch = time(nullptr) - (time_t)photoSecondsElapsed;
        }
    }
    // LUZ (y = 58..80, tx < 160)
    else if (ty >= 58 && ty <= 80 && tx < 160) {
        if (tx < 85) lightHours = max(1, lightHours - step);
        else if (tx > 95) lightHours = min(24, lightHours + step);
    }
    // OSC (y = 58..80, tx >= 170)
    else if (ty >= 58 && ty <= 80 && tx >= 170) {
        if (tx < 255) darkHours = max(1, darkHours - step);
        else if (tx > 265) darkHours = min(24, darkHours + step);
    }
    // MODO VEG/FLOR (y = 84..106)
    else if (ty >= 84 && ty <= 106) {
        isVegetative = !isVegetative;
        weedNeedsRedraw = true;
    }
    // DIAS VEG (y = 110..136)
    else if (ty >= 110 && ty <= 136 && tx < 240) {
        if (tx < 170) daysVeg = max(0, daysVeg - step);
        else if (tx > 190) daysVeg += step;
    }
    // DIAS FLOR (y = 140..166)
    else if (ty >= 140 && ty <= 166 && tx < 240) {
        if (tx < 180) daysFlower = max(0, daysFlower - step);
        else if (tx > 200) daysFlower += step;
    }
    // Saltar fase (y > 196, tx < 100)
    else if (ty > 196 && tx < 100) {
        photoSecondsElapsed = inLightMode ? (lightHours * 3600.0 + 1) : 0;
        if (rtcAnchored) cycleStartEpoch = time(nullptr) - (time_t)photoSecondsElapsed;
    }

    double lightSecs = lightHours * 3600.0;
    inLightMode = (photoSecondsElapsed < lightSecs);
    digitalWrite(RELAY_PIN, inLightMode ? LOW : HIGH);
    uiNeedsFullRedraw = true;
    pendingAction = true;
    stateDirty     = true;
}

void loop() {
    yield();  // cede CPU, evita watchdog

    static uint32_t lastHB=0;
    if (millis()-lastHB>1000) { Serial.println("ALIVE"); lastHB=millis(); }

    updatePhotoperiod();

    // WiFi silencioso
    if (millis()-lastWifiCheck>30000) {
        if (WiFi.status()!=WL_CONNECTED) WiFi.reconnect();
        lastWifiCheck=millis();
    }

    // Salvapantallas nocturno
    struct tm ti;
    bool isNight=false;
    if (getLocalTimeNoBlock(&ti) && ti.tm_hour>=0 && ti.tm_hour<8) isNight=true;

    // Touch – sin bloqueos, solo marca variables
    if (ts.touched()) {
        lastTouchTime = millis();
        if (screensaverActive) {
            screensaverActive = false;
            uiNeedsFullRedraw = true;
            weedNeedsRedraw = true;
            while (ts.touched()) { yield(); delay(10); }
            touchStartTime = 0;
        } else {
            TS_Point p = ts.getPoint();
            int tx = map(p.y, 200, 3800, 320, 0);
            int ty = map(p.x, 200, 3800, 0, 240);
            unsigned long now = millis();
            if (touchStartTime == 0) {
                touchStartTime = now;
                lastTouchActionMs = now;
                handleAction(tx, ty, 1);
            } else {
                unsigned long held = now - touchStartTime;
                unsigned long sinceLast = now - lastTouchActionMs;
                if (held > 1000 && sinceLast > 150) {
                    handleAction(tx, ty, 3);
                    lastTouchActionMs = now;
                } else if (held > 400 && sinceLast > 250) {
                    handleAction(tx, ty, 1);
                    lastTouchActionMs = now;
                }
            }
        }
    } else {
        touchStartTime = 0;
    }

    // Procesar acción pendiente fuera del touch (no bloquea)
    if (pendingAction) {
        pendingAction = false;
        drawUI();              // redibuja al instante, sin tocar la SD
    }

    // Guardado diferido: 3 s después del último toque (evita escrituras
    // de SD en cada tap, que congelaban la interfaz)
    if (stateDirty && millis()-lastTouchTime > 3000) {
        stateDirty = false;
        saveState();
    }

    // Sensores laterales + weedagotchi
    if (!showGraph && !screensaverActive) {
        drawVPD(); drawTDS(); drawCO2(); drawSoilBars();
        drawWeedagotchi();
    }

    // Refresco UI cada segundo
    if (millis()-lastUIRefresh>1000) {
        if (isNight && (millis()-lastTouchTime>30000)) {
            drawScreensaver();
        } else {
            screensaverActive=false;
            if (!showGraph) drawUI(); else drawGraph();
        }
        lastUIRefresh=millis();

        // ESP-NOW send
        if (millis()-lastEspNowSend>3000) {
            struct tm ti2;
            if (getLocalTimeNoBlock(&ti2)) {
                growData.hour=ti2.tm_hour;
                growData.minute=ti2.tm_min;
                growData.second=ti2.tm_sec;
            }
            growData.lightHours    = lightHours;
            growData.darkHours     = darkHours;
            growData.daysVeg       = daysVeg;
            growData.daysFlower    = daysFlower;
            growData.isVegetative  = isVegetative;
            growData.inLightMode   = inLightMode;
            growData.progressPercent =
                (photoSecondsElapsed/((lightHours+darkHours)*3600.0))*100.0;
            growData.vpd = remoteVPD;

            esp_now_send(macInvernadero,   (uint8_t*)&growData, sizeof(growData));
            esp_now_send(macCalendarioESP, (uint8_t*)&growData, sizeof(growData));
            Serial.println("[ESP-NOW] enviado");
            lastEspNowSend=millis();
        }

        handleAutoSave();
    }
}
