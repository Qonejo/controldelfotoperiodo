// ─────────────────────────────────────────────
//  PINES  (ESP32-S3 SuperMini  94:A9:90:37:7A:EC)
// ─────────────────────────────────────────────
#define TFT_CS    10
#define TFT_RST    9
#define TFT_DC     8
#define TOUCH_CS   7
#define SD_CS      5
#define RELAY_PIN  4

// ─────────────────────────────────────────────
//  PALETA DE COLORES  (RGB-565)
//  CORRECCIÓN: MI_MORADO era 0xFFE0 (amarillo). Ahora es morado real.
// ─────────────────────────────────────────────
#define MI_NEGRO      0x0000
#define MI_BLANCO     0xFFFF
#define MI_MORADO     0x780F   // ← CORREGIDO: morado/violeta real
#define MI_NARANJA    0xFD20
#define MI_VERDE_NEON 0x07E0   // verde puro – acento VEG
#define MI_LIMA       0x4FE0   // verde lima suave
#define MI_CYAN_TENUE 0x0410   // cyan oscuro – paneles laterales
#define MI_GRIS_OSC   0x2104   // fondo de secciones
#define MI_ROJO_DIM   0x6000   // rojo apagado
#define MI_AMBER      0xFC60   // ámbar – texto de horario
#define MI_AZUL_DIM   0x001F   // azul oscuridad

Adafruit_ST7789    tft(TFT_CS, TFT_DC, TFT_RST);
XPT2046_Touchscreen ts(TOUCH_CS);

// ─────────────────────────────────────────────
